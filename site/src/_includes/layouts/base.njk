<!doctype html>
{# SPDX-License-Identifier: MIT -#}
{# SPDX-FileCopyrightText: Netresearch DTT GmbH -#}
<html lang="{{ lang or 'en' }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or site.title }}</title>
    <meta name="description" content="{{ description or site.tagline }}" />
    <meta name="theme-color" content="#2F99A4" />
    <meta name="color-scheme" content="light dark" />
    <script>{{ siteThemeBootstrap | safe }}</script>
    {% if robots %}<meta name="robots" content="{{ robots }}" />{% endif %}

    <link rel="canonical" href="{{ site.url }}{{ page.url | url }}" />
    {% if hreflangAlternate %}
      <link rel="alternate" hreflang="{{ hreflangAlternate.lang }}" href="{{ site.url }}{{ hreflangAlternate.url | url }}" />
      <link rel="alternate" hreflang="{{ lang }}" href="{{ site.url }}{{ page.url | url }}" />
      <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ (xDefaultUrl or '/en/') | url }}" />
    {% endif %}

    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:title" content="{{ title or site.title }}" />
    <meta property="og:description" content="{{ description or site.tagline }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url | url }}" />
    <meta property="og:locale" content="{{ ogLocale or 'en_US' }}" />
    <meta property="og:image" content="{{ site.url }}{{ (ogImage or '/assets/og/landing.png') | url }}" />
    <meta property="og:image:alt" content="{{ ogImageAlt or title or site.title }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {% if hreflangAlternate %}
      <meta property="og:locale:alternate" content="{{ hreflangAlternate.ogLocale }}" />
    {% endif %}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content="{{ ogImageAlt or title or site.title }}" />
    <meta name="twitter:image" content="{{ site.url }}{{ (ogImage or '/assets/og/landing.png') | url }}" />

    <link rel="icon" type="image/svg+xml" href="{{ '/assets/site-shell/netresearch-symbol-only.svg' | url }}" />
    <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}" />
    <link rel="stylesheet" href="{{ '/assets/site-shell/site-shell.css' | url }}" />
    <link rel="preload" href="{{ '/assets/fonts/raleway-latin-700-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="{{ '/assets/fonts/open-sans-latin-400-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Netresearch DTT GmbH",
        "url": "{{ site.ownerUrl }}",
        "sameAs": [
          "https://github.com/netresearch",
          "{{ site.repoUrl }}"
        ]
      }
    </script>
  </head>
  <body data-install-mode="{{ installMethods.default }}">
    <a class="skip-link" href="#main">{{ t.nav.skipToContent }}</a>
    {% set homeUrl = ('/' ~ (lang or 'en') ~ '/') | url %}
    {% set isHome = page.url == ('/' ~ (lang or 'en') ~ '/') %}
    {% set enUrl = (page.url if lang == 'en' else hreflangAlternate.url) | url %}
    {% set deUrl = (page.url if lang == 'de' else hreflangAlternate.url) | url %}
    {{ {lang: lang, assetBase: '/assets/site-shell' | url, languageUrls: {en: enUrl, de: deUrl}, contactHref: 'https://www.netresearch.de/kontakt/'} | renderSiteHeader | safe }}
    {{ {lang: lang, title: site.title, titleHref: homeUrl, links: [{href: homeUrl ~ '#skills', label: t.nav.skills}, {href: site.repoUrl, label: t.skill.viewSource}]} | renderPageNavigation | safe }}

    <main id="main" tabindex="-1">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <p>{{ t.footer.maintained }} <a href="{{ site.ownerUrl }}">netresearch.de</a></p>
      <p class="site-footer__meta">{{ t.footer.license }}</p>
      <p class="site-footer__badges">
        <a href="https://scorecard.dev/viewer/?uri=github.com/netresearch/claude-code-marketplace" rel="noopener">OpenSSF Scorecard</a>
        ·
        <a href="{{ site.repoUrl }}/blob/main/LICENSE" rel="noopener">{{ t.footer.licenseLink }}</a>
        ·
        <a href="{{ site.repoUrl }}/commits/main" rel="noopener">{{ t.footer.commitsLink }}</a>
      </p>
    </footer>

    <span class="visually-hidden" data-copy-status role="status" aria-live="polite"></span>
    <script src="{{ '/assets/site-shell/site-shell.js' | url }}" defer></script>
    <script src="{{ '/assets/js/enhance.js' | url }}" defer></script>
  </body>
</html>
